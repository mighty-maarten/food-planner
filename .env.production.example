# Copy to .env.production on the server (git-ignored) and fill in the secrets.
# All variables and their defaults: packages/api/src/config/config.ts and the README.

APP_ENV=production
LOG_LEVEL=log
# Caddy on the proxy LXC is the one proxy in front of the app
TRUST_PROXY_HOPS=1

# Also used by the postgres container to create the database and its user
DATABASE_HOST=postgres
DATABASE_USERNAME=food_planner
DATABASE_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_24
DATABASE_NAME=food_planner

# At least 32 characters: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
