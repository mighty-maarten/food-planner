{
    "name": "@food-planner/api",
    "version": "0.0.0",
    "description": "Food Planner API",
    "private": true,
    "license": "UNLICENSED",
    "type": "module",
    "scripts": {
        "build": "nest build",
        "format": "prettier --write .",
        "start": "nest start",
        "start:local": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main.js",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:cov": "vitest run --coverage",
        "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
        "db:setup": "node dist/database/scripts/index.js -i -m -s",
        "db:migrate": "node dist/database/scripts/index.js -m",
        "db:seed-sample": "node dist/database/scripts/index.js -l",
        "db:setup:local": "npm run build && npm run db:setup",
        "db:migrate:local": "npm run build && npm run db:migrate",
        "db:seed-sample:local": "npm run build && npm run db:seed-sample",
        "user": "node dist/users/scripts/user-cli.js",
        "typecheck": "tsc --noEmit",
        "user:local": "npm run build && npm run user --",
        "format:check": "prettier --check .",
        "lint:fix": "eslint . --fix",
        "import": "node dist/import/import-cli.js",
        "import:local": "npm run build && npm run import --",
        "library-cleanup": "node dist/library-cleanup/cleanup-cli.js",
        "library-cleanup:local": "npm run build && npm run library-cleanup --"
    },
    "dependencies": {
        "@nestjs/common": "^12.2.0",
        "@nestjs/core": "^12.2.0",
        "@nestjs/jwt": "^12.0.3",
        "@nestjs/passport": "^12.0.0",
        "@nestjs/platform-express": "^12.2.0",
        "@nestjs/serve-static": "^12.0.0",
        "@nestjs/swagger": "^12.0.4",
        "@nestjs/throttler": "^6.7.1",
        "@nestjs/typeorm": "^12.0.2",
        "bcrypt": "^6.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "cookie-parser": "^1.4.7",
        "helmet": "^8.3.0",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pg": "^8.23.1",
        "pino": "^10.4.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "typeorm": "^1.1.2",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@nestjs/cli": "^12.0.10",
        "@nestjs/schematics": "^12.0.10",
        "@nestjs/testing": "^12.2.0",
        "@types/bcrypt": "^6.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.5",
        "@types/passport-jwt": "^4.0.1",
        "@types/pg": "^8.23.1",
        "@types/supertest": "^7.2.1",
        "@vitest/coverage-v8": "^5.0.5",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.7",
        "globals": "^17.13.0",
        "pino-pretty": "^13.2.0",
        "prettier": "^3.9.10",
        "source-map-support": "^0.5.21",
        "supertest": "^7.3.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.0",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    },
    "engines": {
        "node": ">=26 <27"
    }
}
