# Copy to .env.local for local development. On the server, these are set in .env.production
# (Docker Compose). All variables and their defaults: src/config/config.ts
APP_ENV=local
ENABLE_SWAGGER=true
ALLOW_DATABASE_SETUP=true

DATABASE_HOST=localhost
DATABASE_PORT=5434
DATABASE_USERNAME=admin
DATABASE_PASSWORD=admin
DATABASE_NAME=food_planner_db

# Any value works locally; at least 32 characters in production
JWT_SECRET=local-development-secret
# Secure cookies need HTTPS, the local setup runs over http
COOKIE_SECURE=false
